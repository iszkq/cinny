+++ b/src/app/utils/pinRecovery.ts
@@ -0,0 +1,29 @@
+const PIN_RESET_REQUEST_KEY = 'starfire-pin-reset-request';
+const REQUEST_LIFETIME_MS = 30 * 60_000;
+
+// Tab-local intent survives logout/reload, but never replaces server authentication.
+export const requestPinReset = (accountKey: string, pinUpdatedAt: number) => {
+  window.sessionStorage.setItem(
+    PIN_RESET_REQUEST_KEY,
+    JSON.stringify({ accountKey, pinUpdatedAt, requestedAt: Date.now() })
+  );
+};
+
+export const consumePinResetRequest = (accountKey: string, pinUpdatedAt?: number): boolean => {
+  const value = window.sessionStorage.getItem(PIN_RESET_REQUEST_KEY);
+  if (!value) return false;
+  window.sessionStorage.removeItem(PIN_RESET_REQUEST_KEY);
+  try {
+    const request = JSON.parse(value);
+    const age = Date.now() - request.requestedAt;
+    return (
+      request.accountKey === accountKey &&
+      request.pinUpdatedAt === pinUpdatedAt &&
+      typeof request.requestedAt === 'number' &&
+      age >= 0 &&
+      age <= REQUEST_LIFETIME_MS
+    );
+  } catch {
+    return false;
+  }
+};
diff --git a/tests/web-pin-lock.test.mjs b/tests/web-pin-lock.test.mjs
