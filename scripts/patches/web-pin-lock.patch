@@ -0,0 +1,282 @@
+import assert from 'node:assert/strict';
+import { webcrypto } from 'node:crypto';
+import { readFileSync } from 'node:fs';
+import test from 'node:test';
+import vm from 'node:vm';
+import ts from 'typescript';
+
+const baseUrl = 'https://matrix.example.org';
+const userId = '@alice:example.org';
+const source = (file) => readFileSync(new URL(`../src/app/${file}`, import.meta.url), 'utf8');
+const compile = (file, globals, imports = {}) => {
+  const exports = {};
+  vm.runInNewContext(
+    ts.transpileModule(source(file), {
+      fileName: file,
+      compilerOptions: {
+        module: ts.ModuleKind.CommonJS,
+        target: ts.ScriptTarget.ES2020,
+        jsx: ts.JsxEmit.React,
+      },
+    }).outputText,
+    {
+      exports,
+      require: (name) => {
+        assert.ok(name in imports, `Unexpected dependency: ${name}`);
+        return imports[name];
+      },
+      ...globals,
+    }
+  );
+  return exports;
+};
+
+function harness() {
+  let now = 1000;
+  const makeStorage = () => {
+    const data = new Map();
+    return {
+      getItem: (key) => data.get(key) ?? null,
+      setItem: (key, value) => data.set(key, value),
+      removeItem: (key) => data.delete(key),
+      clear: () => data.clear(),
+      data,
+    };
+  };
+  const window = Object.assign(new EventTarget(), {
+    localStorage: makeStorage(),
+    sessionStorage: makeStorage(),
+  });
+  const document = Object.assign(new EventTarget(), {
+    visibilityState: 'visible',
+    hasFocus: () => true,
+  });
+  const globals = {
+    window,
+    document,
+    crypto: webcrypto,
+    TextEncoder,
+    URL,
+    Event,
+    btoa,
+    atob,
+    Date: class extends Date {
+      static now() {
+        return now;
+      }
+    },
+  };
+  const idle = compile('utils/idleLock.ts', globals);
+  const recovery = compile('utils/pinRecovery.ts', globals);
+  const desktop = { isDesktopUpdaterSupported: () => false };
+  const pin = compile('utils/pinLock.ts', globals, {
+    './idleLock': idle,
+    './desktopUpdater': desktop,
+    './nativePlatform': { isNativeApp: () => false },
+    './pinRecovery': recovery,
+    '../../types/matrix/accountData': { AccountDataEvent: {} },
+  });
+  return {
+    pin,
+    idle,
+    globals,
+    window,
+    document,
+    desktop,
+    advance: (ms) => {
+      now += ms;
+    },
+  };
+}
+
+test('desktop browsers can configure a salted PIN without storing plaintext', async () => {
+  const { pin, window } = harness();
+  assert.equal(pin.supportsPinLock(), true);
+  assert.equal(pin.isWebPinLockSupported(), true);
+  await pin.enableAccountPin(baseUrl, userId, '001234');
+  assert.equal(await pin.verifyAccountPin(baseUrl, userId, '001234'), true);
+  assert.equal(await pin.verifyAccountPin(baseUrl, userId, '1234'), false);
+  assert.equal(await pin.verifyAccountPin(baseUrl, '@bob:example.org', '001234'), false);
+  assert.ok(!JSON.stringify([...window.localStorage.data]).includes('001234'));
+  if (pin.setPinIdleMinutes) {
+    pin.setPinIdleMinutes(baseUrl, userId, 10);
+    assert.equal(pin.getPinIdleMinutes(baseUrl, userId), 5);
+  }
+});
+
+test('ordinary logout and authenticated login retain the original PIN', async () => {
+  const { pin, window } = harness();
+  const config = await pin.enableAccountPin(baseUrl, userId, '123456');
+  const entries = pin.snapshotPinLockStorage();
+  window.localStorage.clear();
+  pin.restorePinLockStorage(entries);
+  await pin.resetPinAfterAuthenticatedLogin(baseUrl, userId, 'authenticated-token');
+  assert.deepEqual(pin.getAccountPinConfig(baseUrl, userId), config);
+  assert.equal(await pin.verifyAccountPin(baseUrl, userId, '123456'), true);
+  for (let i = 0; i < 5; i += 1)
+    assert.equal(await pin.verifyAccountPin(baseUrl, userId, '0000'), false);
+  assert.equal(pin.hasAccountPin(baseUrl, userId), true);
+});
+
+test('explicit recovery keeps the PIN until fresh authentication, then allows replacement', async () => {
+  const { pin } = harness();
+  await pin.enableAccountPin(baseUrl, userId, '123456');
+  pin.lockScreenForAccount(baseUrl, userId);
+  pin.requestAccountPinReset(baseUrl, userId);
+  assert.equal(pin.hasAccountPin(baseUrl, userId), true);
+  assert.equal(pin.isAccountScreenLocked(baseUrl, userId), true);
+  await pin.resetPinAfterAuthenticatedLogin(baseUrl, userId, 'authenticated-token');
+  assert.equal(pin.hasAccountPin(baseUrl, userId), false);
+  assert.equal(pin.isAccountScreenLocked(baseUrl, userId), false);
+  await pin.enableAccountPin(baseUrl, userId, '654321');
+  await pin.resetPinAfterAuthenticatedLogin(baseUrl, userId, 'authenticated-token');
+  assert.equal(await pin.verifyAccountPin(baseUrl, userId, '654321'), true);
+  assert.equal(await pin.verifyAccountPin(baseUrl, userId, '123456'), false);
+});
+
+test('recovery never resets another account, a changed PIN, or an expired request', async () => {
+  for (const scenario of ['account', 'changed', 'expired']) {
+    const h = harness();
+    await h.pin.enableAccountPin(baseUrl, userId, '123456');
+    h.pin.requestAccountPinReset(baseUrl, userId);
+    if (scenario === 'changed') {
+      h.advance(1);
+      await h.pin.changeAccountPin(baseUrl, userId, '123456', '654321');
+    }
+    if (scenario === 'expired') h.advance(31 * 60_000);
+    await h.pin.resetPinAfterAuthenticatedLogin(
+      baseUrl,
+      scenario === 'account' ? '@bob:example.org' : userId,
+      'authenticated-token'
+    );
+    assert.equal(h.pin.hasAccountPin(baseUrl, userId), true);
+  }
+});
+
+test('idle deadline resets on activity and cannot be bypassed by the first event after sleep', () => {
+  const h = harness();
+  let locks = 0;
+  const idle = h.idle.createIdleLock(
+    5,
+    () => {
+      locks += 1;
+    },
+    h.globals.Date.now
+  );
+  h.advance(299_999);
+  idle.activity();
+  h.advance(299_999);
+  assert.equal(idle.check(), false);
+  h.advance(1);
+  idle.activity();
+  assert.equal(locks, 1);
+  idle.activity();
+  assert.equal(locks, 1);
+});
+
+test('browser idle listeners count background time, restart after unlock, and clean up', async () => {
+  const h = harness();
+  await h.pin.enableAccountPin(baseUrl, userId, '123456');
+  let cleanup;
+  let interval;
+  h.window.setInterval = (callback) => {
+    interval = callback;
+    return 1;
+  };
+  h.window.clearInterval = () => {
+    interval = undefined;
+  };
+  const { usePinIdleLock } = compile('hooks/usePinIdleLock.ts', h.globals, {
+    react: {
+      useEffect: (effect) => {
+        cleanup = effect();
+      },
+    },
+    '../utils/idleLock': h.idle,
+    '../utils/pinLock': h.pin,
+  });
+  usePinIdleLock(baseUrl, userId, true, 5);
+  h.advance(299_999);
+  h.window.dispatchEvent(new Event('keydown'));
+  h.document.visibilityState = 'hidden';
+  h.advance(300_000);
+  h.document.dispatchEvent(new Event('visibilitychange'));
+  assert.equal(h.pin.isAccountScreenLocked(baseUrl, userId), true);
+  cleanup();
+  assert.equal(interval, undefined);
+  h.pin.clearScreenLock();
+  h.document.visibilityState = 'visible';
+  usePinIdleLock(baseUrl, userId, true, 5);
+  h.advance(300_000);
+  h.window.dispatchEvent(new Event('pointerdown'));
+  assert.equal(h.pin.isAccountScreenLocked(baseUrl, userId), true);
+  cleanup();
+});
+
+test('gate requires setup, unlocks after saving, hides chats when locked, and verifies on reload', async () => {
+  const h = harness();
+  let state;
+  let idleArgs;
+  const react = {
+    createElement: (type, props, ...children) => ({ type, props: { ...props, children } }),
+    useState: (init) => {
+      if (state === undefined) state = typeof init === 'function' ? init() : init;
+      return [
+        state,
+        (value) => {
+          state = value;
+        },
+      ];
+    },
+    useEffect: () => {},
+    useCallback: (fn) => fn,
+  };
+  const { ScreenPinLockGate } = compile('components/pin-lock/ScreenPinLockOverlay.tsx', h.globals, {
+    react: { ...react, default: react },
+    folds: { Box: 'Box', Text: 'Text' },
+    '../../hooks/useMatrixClient': { useMatrixClient: () => ({ getUserId: () => userId }) },
+    '../../hooks/usePinLockSnapshot': { usePinLockSnapshot: h.pin.getPinLockSnapshot },
+    '../../hooks/useAccountData': { useAccountData: () => undefined },
+    '../../hooks/usePinIdleLock': {
+      usePinIdleLock: (...args) => {
+        idleArgs = args;
+      },
+    },
+    '../../state/sessions': { getFallbackSession: () => ({ baseUrl }) },
+    '../../utils/pinLock': h.pin,
+    '../../utils/desktopUpdater': h.desktop,
+    '../../constants/branding': { APP_DISPLAY_NAME: '星火', APP_LOGO_URL: '/logo.png' },
+    '../../../types/matrix/accountData': { AccountDataEvent: {} },
+    '../splash-screen': { SplashScreen: 'SplashScreen' },
+    './AccountPinDialog': { AccountPinForm: 'AccountPinForm' },
+    './LocalPinSetupDialog': { LocalPinSetupDialog: 'LocalPinSetupDialog' },
+    '../../features/settings/devices/DeviceTile': { DeviceLogoutBtn: 'DeviceLogoutBtn' },
+    './style.css': {},
+  });
+  const render = () => ScreenPinLockGate({ children: 'private-chat' });
+  const setup = render().props.children[0];
+  assert.equal(setup.type, 'LocalPinSetupDialog');
+  assert.equal(setup.props.onCancel, undefined);
+  await h.pin.enableAccountPin(baseUrl, userId, '123456');
+  setup.props.onSuccess();
+  assert.equal(render(), 'private-chat');
+  assert.equal(idleArgs[2], true);
+  assert.equal(idleArgs[3], 5);
+  h.pin.lockScreenForAccount(baseUrl, userId);
+  const locked = render();
+  assert.equal(locked.props.children[0].type, 'AccountPinForm');
+  assert.equal(idleArgs[2], false);
+  locked.props.children[0].props.onSuccess();
+  assert.equal(render(), 'private-chat');
+  state = undefined;
+  assert.equal(render().props.children[0].type, 'AccountPinForm');
+});
+
+test('server PIN policies cannot clear or replace a browser-local PIN', async () => {
+  const { pin } = harness();
+  if (!pin.applyAccountPinPolicyContent) return;
+  const config = await pin.enableAccountPin(baseUrl, userId, '123456');
+  pin.applyAccountPinPolicyContent(baseUrl, userId, { enabled: false });
+  await pin.syncAccountPinPolicy(baseUrl, userId, 'token');
+  assert.deepEqual(pin.getAccountPinConfig(baseUrl, userId), config);
+});
