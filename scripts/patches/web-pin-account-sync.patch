+const validateWebPinPolicy = (value: unknown): CinnyAccountPinPolicyContent => {
+  if (
+    !isRecord(value) ||
+    value.version !== 1 ||
+    typeof value.enabled !== 'boolean' ||
+    !isFiniteNumber(value.updatedAt)
+  )
+    throw new Error('账号 PIN 设置无效，请重试。');
+  if (value.enabled && ('hash' in value || 'salt' in value || 'iterations' in value)) {
+    if (
+      !isNonEmptyString(value.hash) ||
+      !isNonEmptyString(value.salt) ||
+      !Number.isInteger(value.iterations) ||
+      (value.iterations as number) < 1 ||
+      (value.iterations as number) > 1_000_000
+    )
+      throw new Error('账号 PIN 验证数据无效。');
+    try {
+      if (fromBase64(value.hash).length !== 32 || fromBase64(value.salt).length !== 16)
+        throw new Error();
+    } catch {
+      throw new Error('账号 PIN 验证数据无效。');
+    }
+  }
+  return value as CinnyAccountPinPolicyContent;
+};
+
+const fetchWebPinPolicy = async (baseUrl: string, userId: string, accessToken?: string) => {
+  if (!accessToken) throw new Error('登录状态已失效，请重新登录后同步 PIN 设置。');
+  const response = await fetch(
+    buildAccountPinPolicyUrl(baseUrl, userId, AccountDataEvent.CinnyWebPinPolicy),
+    {
+      method: 'GET',
+      headers: { Authorization: `Bearer ${accessToken}` },
+    }
+  );
+  if (response.status === 404) return undefined;
+  if (!response.ok) throw new Error('无法读取账号 PIN 设置，请检查网络后重试。');
+  return validateWebPinPolicy(await response.json());
+};
+
+// This event is Web-only: never write the policy consumed by native/Windows clients.
+export const applyWebAccountPinPolicyContent = (
+  baseUrl: string,
+  userId: string,
+  content: unknown
+): boolean => {
+  if (!isWebPinLockSupported()) return false;
+  const policy = validateWebPinPolicy(content);
+  const previous = getCachedWebPinPolicy(baseUrl, userId);
+  if (previous && (previous.updatedAt ?? 0) > (policy.updatedAt ?? 0))
+    return hasAccountPin(baseUrl, userId);
+  const key = getAccountPinKey(baseUrl, userId);
+  webPolicyRevisions.set(key, (webPolicyRevisions.get(key) ?? 0) + 1);
+  const policies = readJson<Record<string, CinnyAccountPinPolicyContent>>(WEB_PIN_POLICIES_KEY, {});
+  policies[key] = policy;
+  // Cache first, then notify subscribers after the effective state is installed.
+  safeLocalStorage()?.setItem(WEB_PIN_POLICIES_KEY, JSON.stringify(policies));
+  if (policy.enabled) {
+    const config = getAccountPinPolicyConfig(policy);
+    if (config) cacheAccountPinConfig(baseUrl, userId, config);
+    else clearLocalAccountPin(baseUrl, userId);
+    setWebAccountPinDisabled(baseUrl, userId, false);
+  } else disableWebAccountPin(baseUrl, userId);
+  return policy.enabled === true && hasAccountPin(baseUrl, userId);
+};
+
+const saveWebPinPolicy = async (
+  baseUrl: string,
+  userId: string,
+  accessToken: string | undefined,
+  enabled: boolean,
+  config?: AccountPinConfig,
+  remoteUpdatedAt = 0
+) => {
+  if (!isWebPinLockSupported() || !accessToken)
+    throw new Error('无法保存账号 PIN 设置，请重新登录。');
+  const updatedAt = Math.max(
+    Date.now(),
+    remoteUpdatedAt + 1,
+    (getCachedWebPinPolicy(baseUrl, userId)?.updatedAt ?? 0) + 1
+  );
+  const policy = createAccountPinPolicyContent({ enabled, updatedAt, config });
+  validateWebPinPolicy(policy);
+  const response = await fetch(
+    buildAccountPinPolicyUrl(baseUrl, userId, AccountDataEvent.CinnyWebPinPolicy),
+    {
+      method: 'PUT',
+      headers: { Authorization: `Bearer ${accessToken}`, 'Content-Type': 'application/json' },
+      body: JSON.stringify(policy),
+    }
+  );
+  if (!response.ok) throw new Error('保存账号 PIN 设置失败，请检查网络后重试。');
+  applyWebAccountPinPolicyContent(baseUrl, userId, policy);
+  return getAccountPinPolicyConfig(policy);
+};
+
+export const syncWebAccountPinPolicy = (
+  baseUrl: string,
+  userId: string,
+  accessToken?: string
+): Promise<boolean> => {
+  if (!isWebPinLockSupported()) return Promise.resolve(false);
+  const key = getAccountPinKey(baseUrl, userId);
+  const lookupKey = `${key}::${accessToken}`;
+  const pending = webPolicyLookups.get(lookupKey);
+  if (pending) return pending;
+  const revision = webPolicyRevisions.get(key) ?? 0;
+  const lookup = (async () => {
+    const remote = await fetchWebPinPolicy(baseUrl, userId, accessToken);
+    if ((webPolicyRevisions.get(key) ?? 0) !== revision) return hasAccountPin(baseUrl, userId);
+    if (remote) return applyWebAccountPinPolicyContent(baseUrl, userId, remote);
+    // Only migrate on a confirmed 404, never on offline/auth/server errors.
+    const cached = getCachedWebPinPolicy(baseUrl, userId);
+    if (cached) throw new Error('服务器未返回已同步的 PIN 设置，请重试。');
+    const disabled = isWebAccountPinDisabled(baseUrl, userId);
+    const blocked = isLegacyWebPinMigrationBlocked(baseUrl, userId);
+    const legacy = blocked
+      ? undefined
+      : await fetchAccountPinPolicyContent(baseUrl, userId, accessToken!);
+    if ((webPolicyRevisions.get(key) ?? 0) !== revision) return hasAccountPin(baseUrl, userId);
+    const config = getAccountPinPolicyConfig(legacy) ?? getAccountPinConfig(baseUrl, userId);
+    if (disabled || legacy?.enabled === false || config || blocked) {
+      // Recheck before first publication in case another browser just migrated.
+      const latest = await fetchWebPinPolicy(baseUrl, userId, accessToken);
+      if ((webPolicyRevisions.get(key) ?? 0) !== revision) return hasAccountPin(baseUrl, userId);
+      if (latest) return applyWebAccountPinPolicyContent(baseUrl, userId, latest);
+      await saveWebPinPolicy(
+        baseUrl,
+        userId,
+        accessToken,
+        !disabled && legacy?.enabled !== false,
+        config
+      );
+    }
+    return hasAccountPin(baseUrl, userId);
+  })().finally(() => {
+    webPolicyLookups.delete(lookupKey);
+  });
+  webPolicyLookups.set(lookupKey, lookup);
+  return lookup;
+};
+
+export const enableWebAccountPin = async (
+  baseUrl: string,
+  userId: string,
+  pin: string,
+  accessToken?: string
+): Promise<AccountPinConfig> => {
+  const config = await createPinConfig(pin);
+  const remote = await fetchWebPinPolicy(baseUrl, userId, accessToken);
+  if (remote?.enabled && getAccountPinPolicyConfig(remote)) {
+    applyWebAccountPinPolicyContent(baseUrl, userId, remote);
+    throw new Error('此账号已在其他浏览器设置 PIN，请使用已有 PIN。');
+  }
+  return (await saveWebPinPolicy(baseUrl, userId, accessToken, true, config, remote?.updatedAt))!;
+};
+
+export const changeWebAccountPin = async (
+  baseUrl: string,
+  userId: string,
+  currentPin: string,
+  nextPin: string,
+  accessToken?: string
+): Promise<AccountPinConfig> => {
+  const remote = await fetchWebPinPolicy(baseUrl, userId, accessToken);
+  const current = remote?.enabled ? getAccountPinPolicyConfig(remote) : undefined;
+  if (!current || !(await verifyPinConfig(currentPin, current)))
+    throw new Error('当前账号 PIN 错误或已在其他浏览器变更。');
+  const config = await createPinConfig(nextPin);
+  return (await saveWebPinPolicy(baseUrl, userId, accessToken, true, config, remote?.updatedAt))!;
+};
+
+export const disableSyncedWebAccountPin = async (
+  baseUrl: string,
+  userId: string,
+  accessToken: string | undefined,
+  verified: AccountPinConfig | undefined
+) => {
+  // The dialog has verified the cached PIN; reject if the account changed meanwhile.
+  const remote = await fetchWebPinPolicy(baseUrl, userId, accessToken);
+  if (
+    !verified ||
+    !remote?.enabled ||
+    !isSamePinConfig(getAccountPinPolicyConfig(remote), verified)
+  ) {
+    if (remote) applyWebAccountPinPolicyContent(baseUrl, userId, remote);
+    throw new Error('账号 PIN 设置已变更，请重试。');
+  }
+  await saveWebPinPolicy(baseUrl, userId, accessToken, false, undefined, remote.updatedAt);
+};
