+function accountPinServer() {
+  const data = new Map();
+  const requests = [];
+  let failWrites = false;
+  let failReads = false;
+  const urlFor = (type, account = userId, server = baseUrl) =>
+    `${server}/_matrix/client/v3/user/${encodeURIComponent(account)}/account_data/${type}`;
+  return {
+    data,
+    requests,
+    policy: () => data.get(urlFor(pinEvents.CinnyWebPinPolicy)),
+    legacy: (value) => data.set(urlFor(pinEvents.CinnyAccountPinPolicy), value),
+    failWrites: (value) => {
+      failWrites = value;
+    },
+    failReads: (value) => {
+      failReads = value;
+    },
+    fetch: async (url, init) => {
+      requests.push({ url, ...init });
+      if (init.method === 'PUT') {
+        if (failWrites) return { ok: false, status: 503 };
+        data.set(url, JSON.parse(init.body));
+        return { ok: true, status: 200 };
+      }
+      if (failReads) throw new Error('offline');
+      const value = data.get(url);
+      return value
+        ? { ok: true, status: 200, json: async () => value }
+        : { ok: false, status: 404 };
+    },
+  };
+}
+
+test('two independent browsers share PIN, changed PIN, disabled state, and re-enabling', async () => {
