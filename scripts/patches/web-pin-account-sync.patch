+  assert.equal(
+    a.pin.isWebAccountPinDisabled(baseUrl, userId),
+    false,
+    'new accounts default to setup'
+  );
+  await a.pin.enableWebAccountPin(baseUrl, userId, '001234', 'token');
+  await b.pin.syncWebAccountPinPolicy(baseUrl, userId, 'token');
+  assert.equal(await b.pin.verifyAccountPin(baseUrl, userId, '001234'), true);
+  await assert.rejects(b.pin.enableWebAccountPin(baseUrl, userId, '999999', 'token'));
+  await assert.rejects(a.pin.changeWebAccountPin(baseUrl, userId, '000000', '654321', 'token'));
+  const oldConfig = b.pin.getAccountPinConfig(baseUrl, userId);
+  await a.pin.changeWebAccountPin(baseUrl, userId, '001234', '654321', 'token');
