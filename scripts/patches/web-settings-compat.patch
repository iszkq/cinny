+test('legacy appearance data without a background field preserves uploaded and local-only images', async () => {
+  for (const initial of [
+    {
+      chatBackgroundMediaMxc: 'mxc://example.org/original',
+      chatBackgroundDataUrl: 'data:image/png;base64,bG9jYWw=',
+    },
+    { chatBackgroundDataUrl: 'data:image/png;base64,bG9jYWw=' },
+  ]) {
+    const h = appearanceHarness(initial, { version: 1, themeId: 'remote-theme' });
+    h.render();
+    assert.equal(h.settings().chatBackgroundDataUrl, initial.chatBackgroundDataUrl);
+    assert.equal(h.settings().chatBackgroundMediaMxc, initial.chatBackgroundMediaMxc);
+    h.render();
+    await flushAsync();
+    h.render();
+    for (const callback of h.timers.values()) callback();
+    await flushAsync();
+    assert.ok(h.saves.length > 0, 'preserving a legacy background must not stall future sync');
+    assert.ok(h.saves.at(-1).chatBackgroundMediaMxc);
+  }
+});
+
+test('explicit remote deletion still removes the background and serializes a deletion marker', () => {
+  const h = appearanceHarness(
+    { chatBackgroundDataUrl: 'data:image/png;base64,bG9jYWw=' },
