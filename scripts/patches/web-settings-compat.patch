+test('startup logout preserves PIN and settings; explicit clear-all still deletes them', async () => {
+  const h = harness();
+  const init = readFileSync(new URL('../src/client/initMatrix.ts', import.meta.url), 'utf8');
+  const ast = ts.createSourceFile('initMatrix.ts', init, ts.ScriptTarget.Latest, true);
+  const extract = (name) =>
+    ast.statements
+      .find(
+        (node) =>
+          ts.isVariableStatement(node) &&
+          node.declarationList.declarations.some((d) => d.name.getText(ast) === name)
+      )
+      .getText(ast)
+      .replace(/^export /, '');
+  const noOp = async () => {};
+  let reloads = 0;
+  const context = {
+    window: {
+      localStorage: h.window.localStorage,
+      sessionStorage: h.window.sessionStorage,
+      location: {
+        reload: () => {
+          reloads += 1;
+        },
+      },
+    },
+    pushSessionToSW: () => {},
+    clearClientStores: noOp,
+    clearSecretStorageKeys: noOp,
+    removeAndroidPersistedSession: noOp,
+    clearAllServiceWorkerCaches: noOp,
+    clearAllServiceWorkerRegistrations: noOp,
+    clearDesktopMediaCache: noOp,
+    clearAllIndexedDbDatabases: noOp,
+    SETTINGS_STORAGE_KEY: 'settings',
+    snapshotPinLockStorage: h.pin.snapshotPinLockStorage,
+    restorePinLockStorage: h.pin.restorePinLockStorage,
+  };
+  vm.createContext(context);
+  const functions = [
+    'snapshotLocalStorageEntries',
+    'restoreLocalStorageEntries',
+    'clearAllLocalData',
+    'clearLocalSessionAfterLogout',
+    'clearLoginData',
+  ];
+  vm.runInContext(
+    ts.transpileModule(
+      functions.map(extract).join('\n') +
+        '\nglobalThis.api = { clearLoginData, clearAllLocalData };',
+      { compilerOptions: { target: ts.ScriptTarget.ES2020 } }
+    ).outputText,
+    context
+  );
+  await h.pin.enableAccountPin(baseUrl, userId, '123456');
+  const settings = JSON.stringify({ chatBackgroundDataUrl: 'data:image/png;base64,bG9jYWw=' });
+  h.window.localStorage.setItem('settings', settings);
+  h.window.localStorage.setItem('cinny_access_token', 'old-token');
+  await context.api.clearLoginData();
+  assert.equal(reloads, 1);
+  assert.equal(await h.pin.verifyAccountPin(baseUrl, userId, '123456'), true);
+  assert.equal(h.window.localStorage.getItem('settings'), settings);
+  assert.equal(h.window.localStorage.getItem('cinny_access_token'), null);
+  await context.api.clearAllLocalData();
+  assert.equal(h.pin.hasAccountPin(baseUrl, userId), false);
+  assert.equal(h.window.localStorage.getItem('settings'), null);
+});
