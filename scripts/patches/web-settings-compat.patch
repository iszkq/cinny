diff --git a/src/app/hooks/useWebPinMigration.ts b/src/app/hooks/useWebPinMigration.ts
new file mode 100644
index 0000000..df22abc
--- /dev/null
+++ b/src/app/hooks/useWebPinMigration.ts
@@ -0,0 +1,57 @@
+import { useEffect, useState } from 'react';
+import {
+  getAccountPinKey,
+  hasAccountPin,
+  isLegacyWebPinMigrationBlocked,
+  isWebPinLockSupported,
+  syncAccountPinPolicy,
+} from '../utils/pinLock';
+
+type Lookup = { accountKey: string; status: 'ready' | 'error' };
+
+export function useWebPinMigration(baseUrl?: string, userId?: string, accessToken?: string) {
+  const [lookup, setLookup] = useState<Lookup>();
+  const [attempt, setAttempt] = useState(0);
+  const accountKey = baseUrl && userId ? getAccountPinKey(baseUrl, userId) : undefined;
+  const localReady = Boolean(
+    baseUrl &&
+      userId &&
+      (hasAccountPin(baseUrl, userId) || isLegacyWebPinMigrationBlocked(baseUrl, userId))
+  );
+  const supported = isWebPinLockSupported();
+
+  useEffect(() => {
+    if (!supported || !baseUrl || !userId || !accountKey || localReady) return undefined;
+    let disposed = false;
+    setLookup(undefined);
+    if (!accessToken) {
+      setLookup({ accountKey, status: 'error' });
+      return undefined;
+    }
+    syncAccountPinPolicy(baseUrl, userId, accessToken).then(
+      () => {
+        if (!disposed) setLookup({ accountKey, status: 'ready' });
+      },
+      () => {
+        if (!disposed) setLookup({ accountKey, status: 'error' });
+      }
+    );
+    return () => {
+      disposed = true;
+    };
+  }, [supported, baseUrl, userId, accessToken, accountKey, localReady, attempt]);
+
+  const status =
+    !supported || localReady
+      ? 'ready'
+      : lookup && lookup.accountKey === accountKey
+      ? lookup.status
+      : 'loading';
+  return {
+    status,
+    retry: () => {
+      setLookup(undefined);
+      setAttempt((value) => value + 1);
+    },
+  };
+}
