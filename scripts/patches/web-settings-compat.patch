+  assert.equal(h.settings().chatBackgroundMediaMxc, undefined);
+  const serialized = JSON.parse(
+    JSON.stringify(h.appearance.getAppearanceAccountDataContent(h.settings()))
+  );
+  assert.equal(serialized.chatBackgroundMediaMxc, null);
+});
